generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         String    @default("user")
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cartItems    CartItem[]
  orders       Order[]
  addresses    Address[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  image    String?
  bgColor  String?   @default("#FEF6DA")
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  price       Float
  offerPrice  Float?
  image       String[]
  description String[]
  inStock     Boolean   @default(true)
  isBestSeller Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  amount       Float
  address      String
  status       String      @default("Order Placed")
  paymentType  String      @default("COD")
  isPaid       Boolean     @default(false)
  razorpayOrderId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  image     String
  quantity  Int
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String
  street    String
  city      String
  state     String
  zipcode   String
  country   String  @default("IN")
  phone     String
  createdAt DateTime @default(now())
}
